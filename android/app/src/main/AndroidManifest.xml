<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Δηλώνει ότι η εφαρμογή φιλοξενείται από τον host των templates.

         ΤΟ `required` ΕΙΝΑΙ `false`, ΚΑΙ ΕΙΝΑΙ ΚΡΙΣΙΜΟ.
         ==============================================
         Ήταν `true` και το Play απαντούσε «η συσκευή σας δεν είναι συμβατή με
         αυτήν την έκδοση» σε κάθε κινητό — δηλαδή σε όλους τους δοκιμαστές.

         Το `templates_host` είναι χαρακτηριστικό που δηλώνουν οι συσκευές
         **Android Automotive OS**, όχι τα κινητά· στο κινητό το Android Auto
         είναι απλή εφαρμογή και δεν προσθέτει χαρακτηριστικό συστήματος. Με
         `required="true"` το Play φιλτράρει και αποκλείει κάθε συσκευή που δεν
         το δηλώνει, άρα κάθε τηλέφωνο στον κόσμο.

         Το `required` αφορά **μόνο** το φιλτράρισμα του Play και τη
         δυνατότητα εγκατάστασης. Δεν το διαβάζει κανείς κατά την εκτέλεση: το
         Android Auto αναγνωρίζει την εφαρμογή από την `AiasCarAppService` με
         την κατηγορία πλοήγησης και από τα μεταδεδομένα
         `com.google.android.gms.car.application`. Η αλλαγή σε `false` δεν
         αγγίζει τίποτα από αυτά. -->
    <uses-feature
        android:name="android.software.car.templates_host"
        android:required="false" />

    <!-- ΔΕΝ δηλώνεται το `android.hardware.type.automotive`.
         =================================================
         Υπήρχε εδώ με `required="false"`, ως αβλαβής δήλωση «παίζει και σε
         αυτοκίνητα». Δεν είναι αβλαβής: το Play απορρίπτει το ανέβασμα με
         «δεν μπορεί να δηλώσει τη λειτουργία automotive και τα μεταδεδομένα
         com.google.android.gms.car.application ταυτόχρονα».

         Και έχει δίκιο, γιατί τα δύο είναι ΔΙΑΦΟΡΕΤΙΚΑ ΠΕΡΙΒΑΛΛΟΝΤΑ:

         · `android.hardware.type.automotive` σημαίνει Android Automotive OS —
            λειτουργικό ΜΕΣΑ στο αυτοκίνητο, η εφαρμογή τρέχει στο ίδιο το
            όχημα, χωρίς κινητό.
         · τα μεταδεδομένα `com.google.android.gms.car.application` σημαίνουν
            Android Auto — προβολή ΑΠΟ το κινητό στην οθόνη του αυτοκινήτου.

         Εμείς είμαστε αποκλειστικά το δεύτερο: ολόκληρη η αρχιτεκτονική
         στηρίζεται σε υπηρεσία που τρέχει στο κινητό. Η δήλωση έφυγε. -->

    <!-- Η κατηγορία πλοήγησης είναι η μόνη που δίνει ελεύθερη επιφάνεια
         σχεδίασης. Η ACCESS_SURFACE είναι αυτή που την ξεκλειδώνει. -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <!-- Η υπηρεσία φωνής. Τρέχει στο ΚΙΝΗΤΟ, όχι στο Android Auto: το
         μικρόφωνο της Car App Library είναι για σύντομη είσοδο που ο host
         μπορεί να κόψει, άχρηστο για βοηθό που ακούει συνέχεια. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_aias"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <service
            android:name=".AiasCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>

            <!-- Επίσημη απαίτηση για εφαρμογές πλοήγησης: να μπορούν να
                 δεχτούν αίτημα «πήγαινέ με εκεί». Χωρίς αυτό η εφαρμογή
                 τρέχει μεν, αλλά δεν είναι πλήρης πάροχος πλοήγησης — και
                 είναι υποψήφια εξήγηση για το ότι ο launcher του MG δεν τη
                 δείχνει, ενώ ο εξομοιωτής τη δείχνει. -->
            <intent-filter>
                <action android:name="androidx.car.app.action.NAVIGATE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="geo" />
            </intent-filter>
        </service>

        <!-- Οι τελείες στην οθόνη του κινητού: δοκιμή χωρίς αυτοκίνητο, και
             εφεδρεία αν το Android Auto δυστροπήσει. -->
        <activity
            android:name=".VizActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <service
            android:name=".VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
